{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.zap.capital/data/aero/schema-0.2.json",
  "title": "Zap Capital Aero daily fee and allocation snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "dataset",
    "publisher",
    "license",
    "snapshot",
    "totals",
    "field_sources",
    "pools",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.2\\.\\d+$"
    },
    "dataset": {
      "const": "zap-capital/aero-daily"
    },
    "publisher": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "timestamp_utc",
        "timestamp_dublin",
        "date_utc",
        "chain",
        "chain_id",
        "block_number",
        "generated_at_utc",
        "window"
      ],
      "properties": {
        "timestamp_utc": {
          "type": "string",
          "format": "date-time",
          "description": "Block timestamp of the snapshot block, UTC"
        },
        "timestamp_dublin": {
          "type": "string",
          "format": "date-time",
          "description": "Same instant in Europe/Dublin with offset"
        },
        "date_utc": {
          "type": "string",
          "format": "date"
        },
        "chain": {
          "type": "string",
          "enum": [
            "base"
          ]
        },
        "chain_id": {
          "type": "integer"
        },
        "block_number": {
          "type": "integer"
        },
        "generated_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "window": {
          "type": "object",
          "description": "Timestamp-based 24h window; blocks resolved from block timestamps (no assumed block time)",
          "required": [
            "seconds",
            "start_block",
            "start_timestamp_utc",
            "end_block",
            "end_timestamp_utc",
            "event_blocks",
            "blocks_in_window",
            "fee_sample_count",
            "fee_sample_spacing_seconds"
          ],
          "properties": {
            "seconds": {
              "type": "integer"
            },
            "start_block": {
              "type": "integer"
            },
            "start_timestamp_utc": {
              "type": "string",
              "format": "date-time"
            },
            "end_block": {
              "type": "integer"
            },
            "end_timestamp_utc": {
              "type": "string",
              "format": "date-time"
            },
            "event_blocks": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "blocks_in_window": {
              "type": "integer"
            },
            "fee_sample_count": {
              "type": "integer"
            },
            "fee_sample_spacing_seconds": {
              "type": "integer"
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "gauge_count",
        "gauges_with_allocation",
        "pools_in_file",
        "total_allocation_power",
        "allocation_pct_in_file",
        "tvl_usd_in_file",
        "protocol_fees_last_utc_day",
        "aero_price_usd",
        "aero_price_timestamp_utc",
        "gross_swap_fees_24h_usd_est_in_file"
      ],
      "properties": {
        "gauge_count": {
          "type": "integer"
        },
        "gauges_with_allocation": {
          "type": "integer"
        },
        "pools_in_file": {
          "type": "integer"
        },
        "total_allocation_power": {
          "type": "number",
          "description": "Sum of AP over every Base gauge, in AERO-equivalent units"
        },
        "allocation_pct_in_file": {
          "type": "number"
        },
        "tvl_usd_in_file": {
          "type": "number"
        },
        "protocol_fees_last_utc_day": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "date_utc": {
              "type": "string",
              "format": "date"
            },
            "all_chains_usd": {
              "type": "number"
            },
            "base_usd": {
              "type": [
                "number",
                "null"
              ]
            },
            "all_chains_7d_usd": {
              "type": [
                "number",
                "null"
              ]
            },
            "protocol_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "aero_price_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "aero_price_timestamp_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "gross_swap_fees_24h_usd_est_in_file": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "field_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pools": {
      "type": "array",
      "description": "Sorted by allocation_pct, descending",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "pool_name",
          "pair",
          "pool_type",
          "fee_tier",
          "tick_spacing",
          "fee_pct",
          "pool_address",
          "gauge_address",
          "token0",
          "token1",
          "gauge_activated",
          "allocation_power",
          "allocation_power_permanent",
          "allocation_pct",
          "volume_24h_usd",
          "tvl_usd",
          "emission_cap_aero_per_week",
          "incentives_usd_per_week",
          "notes",
          "fee_pct_spot",
          "voting_rewards_manager",
          "gross_swap_fees_24h_usd_est"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "pool_name": {
            "type": "string"
          },
          "pair": {
            "type": "string"
          },
          "pool_type": {
            "type": "string",
            "enum": [
              "cl",
              "volatile",
              "stable",
              "unknown"
            ]
          },
          "fee_tier": {
            "type": "string",
            "description": "CL<tickSpacing> | volatile | stable | unknown"
          },
          "tick_spacing": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fee_pct": {
            "type": [
              "number",
              "null"
            ],
            "description": "Swap fee in percent (0.04 = 0.04%): CL = time-weighted mean of 24 hourly fee() reads over the true 24h window; volatile/stable = spot"
          },
          "pool_address": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "gauge_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "token0": {
            "$ref": "#/$defs/token"
          },
          "token1": {
            "$ref": "#/$defs/token"
          },
          "gauge_activated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "allocation_power": {
            "type": "number"
          },
          "allocation_power_permanent": {
            "type": [
              "number",
              "null"
            ]
          },
          "allocation_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "volume_24h_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "tvl_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "emission_cap_aero_per_week": {
            "type": [
              "number",
              "null"
            ]
          },
          "incentives_usd_per_week": {
            "type": [
              "number",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fee_pct_spot": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fee in percent at the snapshot block"
          },
          "voting_rewards_manager": {
            "type": [
              "string",
              "null"
            ]
          },
          "gross_swap_fees_24h_usd_est": {
            "type": [
              "number",
              "null"
            ],
            "description": "volume_24h_usd x fee_pct / 100: gross swap fees, all LPs, estimate; not the amount paid to allocators"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "required": [
        "address",
        "symbol"
      ],
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
